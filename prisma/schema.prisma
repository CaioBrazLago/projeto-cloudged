// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Aliquota {
  id         String    @id @default(uuid())
  uf         String
  ncm        String
  aliquota   Decimal   @db.Decimal(5, 4)
  dataInicio DateTime
  dataFim    DateTime?

  @@index([uf, ncm])
  @@map("aliquotas")
}

enum ItemStatus {
  CALCULADO
  PENDENTE_ALIQUOTA
}

model NotaItem {
  id            String     @id @default(uuid())
  ncm           String
  quantidade    Decimal    @db.Decimal(15, 4)
  valorUnitario Decimal    @db.Decimal(15, 2)
  aliquota      Decimal?   @db.Decimal(5, 4)
  credito       Decimal?   @db.Decimal(15, 2)
  status        ItemStatus

  notaId String
  nota   Nota   @relation(fields: [notaId], references: [id], onDelete: Cascade)

  @@index([notaId])
  @@map("nota_itens")
}

model Nota {
  id           String     @id @default(uuid())
  numeroNota   String     @unique
  uf           String
  dataEmissao  DateTime
  creditoTotal Decimal    @db.Decimal(15, 2)
  payloadHash  String
  itens        NotaItem[]

  @@map("notas")
}
