generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItemStatus {
  CALCULADO
  PENDENTE_ALIQUOTA
}

model Aliquota {
  id         String    @id @default(uuid())
  uf         String    @db.VarChar(2)
  ncm        String    @db.VarChar(8)
  aliquota   Decimal   @db.Decimal(5, 4)
  dataInicio DateTime  @db.Date
  dataFim    DateTime? @db.Date

  @@index([uf, ncm])
  @@map("aliquotas")
}

model Nota {
  id           String     @id @default(uuid())
  numeroNota   String     @unique
  uf           String     @db.VarChar(2)
  dataEmissao  DateTime   @db.Date
  creditoTotal Decimal    @db.Decimal(15, 2)
  payloadHash  String     @db.VarChar(64)
  itens        NotaItem[]

  @@map("notas")
}

model NotaItem {
  id            String     @id @default(uuid())
  ncm           String     @db.VarChar(8)
  quantidade    Decimal    @db.Decimal(15, 4)
  valorUnitario Decimal    @db.Decimal(15, 2)
  aliquota      Decimal?   @db.Decimal(5, 4)
  credito       Decimal?   @db.Decimal(15, 2)
  status        ItemStatus

  notaId String
  nota   Nota   @relation(fields: [notaId], references: [id], onDelete: Cascade)

  @@index([notaId])
  @@map("nota_itens")
}
